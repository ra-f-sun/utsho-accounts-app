// ============================================
// MEC Models (English Tutoring - Simplified)
// ============================================

model MecStudent {
  id                 String       @id @default(uuid())
  name               String
  gender             Gender
  dateOfBirth        DateTime
  class              Int?
  group              String?
  section            String?
  serialNo           String?
  // Personal details (all optional)
  nationality        String?      @default("Bangladeshi")
  religion           String?
  bloodGroup         String?
  healthCondition    String?
  presentAddress     String?
  studentLivingWith  String?
  lastSchoolAttended String?
  // Father info (all optional)
  fatherName         String?
  fatherMobile       String?
  fatherOccupation   String?
  fatherEmail        String?
  // Mother info (all optional)
  motherName         String?
  motherMobile       String?
  motherOccupation   String?
  motherEmail        String?
  // Primary contact
  guardianName       String
  contactNumber      String
  // Fees
  monthlyTuitionFee   Float
  admissionFee        Float?
  readmissionFee      Float?
  discountTuition     Float?       @default(0)
  discountAdmission   Float?       @default(0)
  discountReadmission Float?       @default(0)
  admissionDate        DateTime?
  // System
  isActive             Boolean      @default(true)
  associationEndDate   DateTime?    // NULL = active; set = no longer associated
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  payments             MecPayment[]

  @@index([isActive])
  @@map("mec_students")
}

model MecPayment {
  id            String     @id @default(uuid())
  studentId     String
  student       MecStudent @relation(fields: [studentId], references: [id])
  // Note: MEC only has tuition payments, no paymentType enum needed
  amount        Float      // Office/actual amount (post-discount) — source of truth for financials
  paymentMonth  DateTime
  paymentDate   DateTime
  paymentMethod PaymentMethod
  invoiceNumber String     @unique
  notes         String?
  createdBy     String // FK → users.id
  createdAt     DateTime   @default(now())
  isActive      Boolean    @default(true)
  updatedAt     DateTime   @updatedAt
  // Dual invoice fields (Feature 6A)
  guardianAmount     Float?              // Display amount for guardian (pre-discount), per-line-item
  officeSubTotal     Float?              // Sum of actual (post-discount) amounts (invoice-level)
  guardianSubTotal   Float?              // Sum of guardian (pre-discount) amounts (invoice-level)
  additionalDiscount Float?   @default(0) // Extra discount entered by accountant (invoice-level)
  officeGrandTotal   Float?              // officeSubTotal - additionalDiscount
  guardianGrandTotal Float?              // guardianSubTotal - additionalDiscount
  officePaid         Float?              // officeGrandTotal - dueAmount
  guardianPaid       Float?              // guardianGrandTotal - dueAmount
  dueAmount          Float?   @default(0) // Amount kept as due (invoice-level)
  // Due collection fields (Feature 6B)
  parentInvoiceNumber String?             // Links due collection to original invoice
  isDueCollection     Boolean  @default(false)

  @@index([studentId, paymentMonth])
  @@index([paymentDate])
  @@index([parentInvoiceNumber])
  @@map("mec_payments")
}

// ============================================
// Promotion Logs (shared across all orgs)
// ============================================

model PromotionLog {
  id           String   @id @default(uuid())
  organization String   // 'uac', 'mbcs', 'mec'
  studentId    String
  fromClass    Int
  toClass      Int
  promotedAt   DateTime @default(now())
  promotedBy   String   // user ID who performed the promotion
  notes        String?

  @@index([organization, studentId])
  @@index([promotedAt])
  @@map("promotion_logs")
}

// ============================================
// Shared Models
// ============================================

model Expense {
  id            String   @id @default(uuid())
  organization  String // 'uac', 'mbcs', 'mec'
  expenseType   ExpenseType
  amount        Float
  expenseMonth  DateTime // YYYY-MM-01 format
  paymentDate   DateTime
  paymentMethod PaymentMethod
  notes         String?
  createdBy     String // FK → users.id
  createdAt     DateTime @default(now())
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([organization, expenseMonth])
  @@map("expenses")
}

model InvoiceCounter {
  year         Int
  organization String
  sequence     Int    @default(0)

  @@id([year, organization])
  @@map("invoice_counters")
}

model OrgSettings {
  id           String   @id @default(uuid())
  organization String   // 'uac', 'mbcs', 'mec'
  settingKey   String   // e.g., 'tuition_default', 'admission_default', 'discount_tuition_options', 'study_materials'
  settingValue Json     // flexible JSON value (number, string, array, object)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([organization, settingKey])
  @@index([organization])
  @@map("org_settings")
}
