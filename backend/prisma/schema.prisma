// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Auth & Users
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ACCOUNTANT_UAC
  ACCOUNTANT_MBCS
  ACCOUNTANT_MEC
}

enum Gender {
  male
  female
  other
}

enum PaymentMethod {
  cash
  bkash
  nagad
  bank_transfer
}

enum PayableType {
  teacher
  staff
}

enum Shift {
  morning
  day
}

enum ExpenseType {
  rent
  electricity
  water
  internet
  salary
  other
}

enum TeacherSalaryType {
  fixed
  lecture_based
}

enum UacPaymentType {
  tuition
  admission
  readmission
  exam
  sheet
  session_charge
  study_materials
  study_tour
  other
}

enum MbcsPaymentType {
  tuition
  admission
  readmission
  late_fee
  exam
  session_charge
  study_materials
  study_tour
  stationary
  other
}

// ============================================
// UAC Models (Coaching Center)
// ============================================

model UacStudent {
  id                 String       @id @default(uuid())
  name               String
  gender             Gender
  dateOfBirth        DateTime
  class              Int // 8-12
  group              String? // 'science', 'business' (class >= 9 only)
  section            String? // 'A', 'B', etc.
  school             String? // Which school they attend
  serialNo           String? // Institution roll/serial number
  // Personal details
  nationality        String?      @default("Bangladeshi")
  religion           String?
  bloodGroup         String? // 'A+', 'B-', 'O+', etc.
  healthCondition    String? // Health notes
  presentAddress     String?
  studentLivingWith  String? // 'both_parents', 'father', 'mother', 'other'
  lastSchoolAttended String?
  // Father info
  fatherName         String?
  fatherMobile       String?
  fatherOccupation   String?
  fatherEmail        String?
  // Mother info
  motherName         String?
  motherMobile       String?
  motherOccupation   String?
  motherEmail        String?
  // Primary contact
  guardianName       String // Primary contact person
  contactNumber      String // Primary contact number
  // Fees
  monthlyTuitionFee   Float
  admissionFee        Float?
  readmissionFee      Float?
  discountTuition     Float?       @default(0)
  discountAdmission   Float?       @default(0)
  discountReadmission Float?       @default(0)
  admissionDate        DateTime?
  // System
  isActive             Boolean      @default(true)
  isPromoted           Boolean      @default(false) // true = reached current class via promotion (needs readmission fee)
  associationEndDate   DateTime?    // NULL = active; set = no longer associated
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  payments             UacPayment[]

  @@index([class, group])
  @@index([school])
  @@index([isActive])
  @@map("uac_students")
}

model UacTeacher {
  id             String                 @id @default(uuid())
  name           String
  contactNumber  String
  paymentType    TeacherSalaryType // 'fixed' or 'lecture_based'
  monthlySalary  Float? // For fixed payment
  perLectureRate Float? // For lecture-based
  subjects       Json? // Array of {class, subject}
  isActive             Boolean                @default(true)
  associationEndDate   DateTime?              // NULL = active; set = no longer associated
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attendance           UacTeacherAttendance[]

  @@map("uac_teachers")
}

model UacStaff {
  id            String   @id @default(uuid())
  name          String
  contactNumber String
  designation   String?
  monthlySalary      Float
  isActive           Boolean  @default(true)
  associationEndDate DateTime? // NULL = active; set = no longer associated
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("uac_staff")
}

model UacPayment {
  id            String     @id @default(uuid())
  studentId     String
  student       UacStudent @relation(fields: [studentId], references: [id])
  paymentType   UacPaymentType
  amount        Float      // Office/actual amount (post-discount) — source of truth for financials
  paymentMonth  DateTime // YYYY-MM-01 format
  paymentDate   DateTime
  paymentMethod PaymentMethod
  invoiceNumber String     @unique
  notes         String? // Description when paymentType is 'other'
  createdBy     String // FK → users.id (audit trail)
  createdAt     DateTime   @default(now())
  isActive      Boolean    @default(true)
  updatedAt     DateTime   @updatedAt
  // Dual invoice fields (Feature 6A)
  guardianAmount     Float?              // Display amount for guardian (pre-discount), per-line-item
  officeSubTotal     Float?              // Sum of actual (post-discount) amounts (invoice-level)
  guardianSubTotal   Float?              // Sum of guardian (pre-discount) amounts (invoice-level)
  additionalDiscount Float?   @default(0) // Extra discount entered by accountant (invoice-level)
  officeGrandTotal   Float?              // officeSubTotal - additionalDiscount
  guardianGrandTotal Float?              // guardianSubTotal - additionalDiscount
  officePaid         Float?              // officeGrandTotal - dueAmount
  guardianPaid       Float?              // guardianGrandTotal - dueAmount
  dueAmount          Float?   @default(0) // Amount kept as due (invoice-level)
  // Due collection fields (Feature 6B)
  parentInvoiceNumber String?             // Links due collection to original invoice
  isDueCollection     Boolean  @default(false) // Distinguishes due collection from fresh payment

  @@index([studentId, paymentMonth])
  @@index([paymentDate])
  @@index([parentInvoiceNumber])
  @@map("uac_payments")
}

model UacTeacherAttendance {
  id             String     @id @default(uuid())
  teacherId      String
  teacher        UacTeacher @relation(fields: [teacherId], references: [id])
  class          Int?
  subject        String?
  attendanceDate DateTime
  lecturesTaken  Int        @default(1)
  createdAt      DateTime   @default(now())

  @@index([teacherId, attendanceDate])
  @@map("uac_teacher_attendance")
}

model UacPayroll {
  id            String   @id @default(uuid())
  payableType   PayableType
  payableId     String // Teacher or Staff UUID
  paymentMonth  DateTime // YYYY-MM-01 format
  amount        Float
  totalLectures Int? // For lecture-based teachers only
  paymentDate   DateTime
  paymentMethod PaymentMethod
  invoiceNumber String   @unique
  notes         String?
  createdBy     String // FK → users.id (audit trail)
  createdAt     DateTime @default(now())
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  // Due fields (Feature 6F)
  paidAmount      Float?              // What was actually paid (defaults to amount)
  dueAmount       Float?   @default(0) // Amount kept as due
  // Due collection fields (Feature 6B)
  parentPayrollId String?             // Links due collection to original payroll
  isDueCollection Boolean  @default(false)

  @@index([payableType, payableId, paymentMonth])
  @@map("uac_payroll")
}

// ============================================
// MBCS Models (Kindergarten)
// ============================================

model MbcsStudent {
  id                 String        @id @default(uuid())
  name               String
  gender             Gender
  dateOfBirth        DateTime
  class              Int
  shift              Shift? // 'morning', 'day' (instead of group)
  section            String? // 'A', 'B', etc.
  branch             String? // 'Basabo Branch' (instead of school)
  serialNo           String? // Institution roll/serial number
  // Personal details
  nationality        String?       @default("Bangladeshi")
  religion           String?
  bloodGroup         String?
  healthCondition    String?
  presentAddress     String?
  studentLivingWith  String? // 'both_parents', 'father', 'mother', 'other'
  lastSchoolAttended String?
  // Father info
  fatherName         String?
  fatherMobile       String?
  fatherOccupation   String?
  fatherEmail        String?
  // Mother info
  motherName         String?
  motherMobile       String?
  motherOccupation   String?
  motherEmail        String?
  // Primary contact
  guardianName       String
  contactNumber      String
  // Fees
  monthlyTuitionFee   Float
  admissionFee        Float?
  readmissionFee      Float?
  discountTuition     Float?        @default(0)
  discountAdmission   Float?        @default(0)
  discountReadmission Float?        @default(0)
  admissionDate        DateTime?
  // System
  isActive             Boolean       @default(true)
  isPromoted           Boolean       @default(false) // true = reached current class via promotion (needs readmission fee)
  associationEndDate   DateTime?     // NULL = active; set = no longer associated
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  payments             MbcsPayment[]

  @@index([class, shift])
  @@index([branch])
  @@index([isActive])
  @@map("mbcs_students")
}

model MbcsTeacher {
  id             String                  @id @default(uuid())
  name           String
  contactNumber  String
  paymentType    TeacherSalaryType // 'fixed' or 'lecture_based'
  monthlySalary  Float?
  perLectureRate Float?
  subjects       Json?
  isActive             Boolean                 @default(true)
  associationEndDate   DateTime?               // NULL = active; set = no longer associated
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  attendance           MbcsTeacherAttendance[]

  @@map("mbcs_teachers")
}

model MbcsStaff {
  id            String   @id @default(uuid())
  name          String
  contactNumber String
  designation   String?
  monthlySalary      Float
  isActive           Boolean  @default(true)
  associationEndDate DateTime? // NULL = active; set = no longer associated
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("mbcs_staff")
}

