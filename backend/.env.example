# ===========================================
# Utsho Accounting System - Environment Variables
# ===========================================

# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://postgres:password@localhost:5432/utsho_db
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/utsho_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="7d"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5174"

# Seed password (required in production when running prisma db seed)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SEED_PASSWORD="change-this-before-seeding-in-production"
